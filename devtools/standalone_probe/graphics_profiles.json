{
  "software": {
    "hosts": ["qt", "electron", "tauri"],
    "description": "Explicit software request; inspect the actual renderer separately",
    "set_env": {"LIBGL_ALWAYS_SOFTWARE": "1"},
    "unset_env": [],
    "chromium_switches": ["use-gl=angle", "use-angle=swiftshader", "enable-unsafe-swiftshader", "disable-gpu-compositing"]
  },
  "default": {
    "hosts": ["qt", "electron", "tauri"],
    "description": "Ordinary host renderer selection; hardware acceleration is not presumed",
    "set_env": {},
    "unset_env": ["LIBGL_ALWAYS_SOFTWARE", "MESA_LOADER_DRIVER_OVERRIDE", "VK_LOADER_DRIVERS_SELECT", "VK_DRIVER_FILES", "VK_ICD_FILENAMES"],
    "chromium_switches": []
  },
  "angle-vulkan": {
    "hosts": ["qt", "electron"],
    "description": "Experimental ANGLE Vulkan request with CPU window composition; not native desktop acceptance",
    "set_env": {"VK_LOADER_DRIVERS_SELECT": "nvidia_icd.json"},
    "unset_env": ["LIBGL_ALWAYS_SOFTWARE", "MESA_LOADER_DRIVER_OVERRIDE", "VK_DRIVER_FILES", "VK_ICD_FILENAMES"],
    "chromium_switches": ["use-gl=angle", "use-angle=vulkan", "disable-gpu-compositing"]
  }
}
