 "comments": [
  {
   "commentType": "FUNCTION",
   "texts": [
    {
     "value": "Hydrolyzes phosphodiester bonds in RNA, poly- and oligoribonucleotides resulting in 3'-nucleoside monophosphates via 2',3'-cyclophosphate intermediates"
    }
   ]
  },
  {
   "commentType": "SUBCELLULAR LOCATION",
